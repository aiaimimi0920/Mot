<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>G2A.InteractionOrigin</RootNamespace>
    <AssemblyName>G2A.InteractionOrigin</AssemblyName>
    <PackageId>G2A.InteractionOrigin</PackageId>
    <Version>0.0.1</Version>
    <Authors>G2A Reference Project</Authors>
    <Description>Zero-dependency G2A V0.0.1 Interaction Origin SDK for C#, .NET 8, and Unity game hosts.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/aiaimimi0920/Mot.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>g2a;game-ai;companion;npc;unity;interaction-origin</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
